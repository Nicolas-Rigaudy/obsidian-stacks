{
  "name": "obsidian-stacks",
  "version": "0.1.0",
  "description": "Config-driven gallery + kanban board engine for Obsidian media libraries (books, comics, games, movies).",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy": "bash scripts/deploy.sh",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin"
  ],
  "author": "Nicolas Rigaudy",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
